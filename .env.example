# npu-board configuration (copy values into your shell profile or systemd unit)
# All scripts read these; placeholders must be replaced before use.

# SSH key: bastion -> all NPU nodes (root)
NPU_KEY=/root/.ssh/id_rsa

# Repo/deployment root on the bastion (where sweep snapshots are written)
NPU_MON=/opt/npu-board

# Full node list (space-separated)
NPU_IPS="10.0.0.1 10.0.0.2 10.0.0.3 10.0.0.4"

# Board display groups (subsets of NPU_IPS; used for the per-rack stat tiles)
NPU_GROUP_A="10.0.0.1 10.0.0.2"
NPU_GROUP_B="10.0.0.3 10.0.0.4"
